# =============================================
# Supabase PostgreSQL Connection (REQUIRED)
# =============================================
# Pooler URL (for runtime queries - uses pgbouncer)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct URL (for Prisma migrations - uses direct connection)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# =============================================
# Facebook API (for auto-publishing)
# =============================================
FB_ACCESS_TOKEN=
FB_PAGE_ID=

# =============================================
# Kie.ai API (for AI features)
# Claude Opus 4.8, GPT Image 2, Grok Imagine Video
# =============================================
KIE_API_KEY=
